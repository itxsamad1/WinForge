<Application x:Class="WinForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#07090E"/>
    <SolidColorBrush x:Key="CardBrush" Color="#131824"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#222938"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EEF2F9"/>
    <SolidColorBrush x:Key="DimBrush" Color="#9AA4B8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0078FF"/>
    <SolidColorBrush x:Key="OkBrush" Color="#35C37D"/>
  </Application.Resources>
</Application>
