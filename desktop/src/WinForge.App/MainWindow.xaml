<Window x:Class="WinForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinForge"
        Height="820" Width="1180"
        MinHeight="640" MinWidth="960"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="120"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Image Source="/Assets/logo-mark.png" Width="40" Height="40" Margin="0,0,12,0"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="WinForge" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="Forge your perfect Windows experience" Foreground="{StaticResource DimBrush}" FontSize="12"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
        <Button Content="Rescan" Margin="0,0,8,0" Padding="12,6" Command="{Binding RescanCommand}"/>
        <Button Content="Save profile" Margin="0,0,8,0" Padding="12,6" Command="{Binding SaveProfileCommand}"/>
        <Button Content="Load profile" Padding="12,6" Command="{Binding LoadProfileCommand}"/>
      </StackPanel>
    </DockPanel>

    <!-- Tabs -->
    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
      <!-- Install -->
      <TabItem Header="Install">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBox Grid.Row="0" Margin="0,0,0,8" Padding="10,8"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   Background="#0E121A" BorderBrush="{StaticResource BorderBrush}"
                   Foreground="{StaticResource TextBrush}"
                   Tag="Search apps..."/>

          <ItemsControl Grid.Row="1" Margin="0,0,0,8" ItemsSource="{Binding Presets}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Name}" Margin="0,0,8,8" Padding="10,6"
                        Tag="{Binding}"
                        Click="Preset_Click"
                        Background="#1A2230" BorderBrush="{StaticResource BorderBrush}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ListView Grid.Row="2" ItemsSource="{Binding FilteredApps}"
                    Background="#0E121A" BorderBrush="{StaticResource BorderBrush}">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="40">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="App" Width="220" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="Description" Width="520" DisplayMemberBinding="{Binding Description}"/>
                <GridViewColumn Header="Status" Width="100">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding IsInstalled, Converter={StaticResource InstalledConverter}}"
                                 Foreground="{StaticResource OkBrush}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>

      <!-- Tweaks -->
      <TabItem Header="Tweaks">
        <DockPanel Margin="12">
          <Button DockPanel.Dock="Bottom" Content="Apply selected tweaks" Margin="0,8,0,0"
                  Padding="12,8" HorizontalAlignment="Left"
                  Background="{StaticResource AccentBrush}" Foreground="White"
                  Command="{Binding ApplyTweaksCommand}"/>
          <ListView ItemsSource="{Binding Tweaks}" Background="#0E121A" BorderBrush="{StaticResource BorderBrush}">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="40">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Tweak" Width="220" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="Group" Width="120" DisplayMemberBinding="{Binding Group}"/>
                <GridViewColumn Header="Risk" Width="80" DisplayMemberBinding="{Binding Risk}"/>
                <GridViewColumn Header="Description" Width="480" DisplayMemberBinding="{Binding Description}"/>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>

      <!-- Config -->
      <TabItem Header="Config">
        <ListView Margin="12" ItemsSource="{Binding Fixes}" Background="#0E121A"
                  BorderBrush="{StaticResource BorderBrush}">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Fix" Width="220" DisplayMemberBinding="{Binding Name}"/>
              <GridViewColumn Header="Description" Width="560" DisplayMemberBinding="{Binding Description}"/>
              <GridViewColumn Header="" Width="100">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Run" Padding="8,4" Tag="{Binding}" Click="Fix_Click"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </TabItem>

      <!-- Updates -->
      <TabItem Header="Updates">
        <ListView Margin="12" ItemsSource="{Binding UpdatePolicies}" Background="#0E121A"
                  BorderBrush="{StaticResource BorderBrush}">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Policy" Width="200" DisplayMemberBinding="{Binding Name}"/>
              <GridViewColumn Header="Description" Width="520" DisplayMemberBinding="{Binding Description}"/>
              <GridViewColumn Header="" Width="100">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Apply" Padding="8,4" Tag="{Binding}" Click="Policy_Click"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </TabItem>

      <!-- Settings -->
      <TabItem Header="Settings">
        <StackPanel Margin="12" MaxWidth="480">
          <TextBlock Text="Git identity (optional)" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="Name" Foreground="{StaticResource DimBrush}"/>
          <TextBox Text="{Binding GitName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="8"/>
          <TextBlock Text="Email" Foreground="{StaticResource DimBrush}"/>
          <TextBox Text="{Binding GitEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="8"/>
          <TextBlock Text="Applied after Git installs via post-install scripts." TextWrapping="Wrap"
                     Foreground="{StaticResource DimBrush}" FontSize="12"/>
        </StackPanel>
      </TabItem>
    </TabControl>

    <!-- Progress -->
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4"/>
      <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="8"
                   Background="#0E121A" Foreground="{StaticResource AccentBrush}"/>
    </StackPanel>

    <!-- Status + Install bar -->
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Install selected" Padding="16,10"
              Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold"
              Command="{Binding InstallCommand}"/>
      <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" Foreground="{StaticResource DimBrush}"/>
    </DockPanel>
  </Grid>
</Window>
