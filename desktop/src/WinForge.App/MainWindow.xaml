<Window x:Class="WinForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinForge"
        Height="860" Width="1220"
        MinHeight="680" MinWidth="980"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Image Source="/Assets/logo-mark.png" Width="42" Height="42" Margin="0,0,12,0"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="WinForge" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="Forge your perfect Windows experience"
                     Foreground="{StaticResource DimBrush}" FontSize="12.5"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
        <Button Content="Rescan" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                Command="{Binding RescanCommand}"/>
        <Button Content="Save profile" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                Command="{Binding SaveProfileCommand}"/>
        <Button Content="Load profile" Style="{StaticResource GhostButton}"
                Command="{Binding LoadProfileCommand}"/>
      </StackPanel>
    </DockPanel>

    <!-- Tabs -->
    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="Install">
        <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="14" Margin="0,8,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" Margin="0,0,0,12"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search apps"/>

            <ItemsControl Grid.Row="1" Margin="0,0,0,10" ItemsSource="{Binding Presets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding Name}"
                          Style="{StaticResource PresetButton}"
                          Tag="{Binding}"
                          Click="Preset_Click"
                          ToolTip="{Binding Description}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ListView Grid.Row="2" ItemsSource="{Binding FilteredApps}">
              <ListView.View>
                <GridView>
                  <GridViewColumn Width="44">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="App" Width="230">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Description" Width="560">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{StaticResource DimBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Status" Width="110">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding IsInstalled, Converter={StaticResource InstalledConverter}}"
                                   Foreground="{StaticResource OkBrush}"
                                   FontWeight="SemiBold"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </Border>
      </TabItem>

      <TabItem Header="Tweaks">
        <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="14" Margin="0,8,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="Apply selected tweaks"
                    Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                    HorizontalAlignment="Left" Command="{Binding ApplyTweaksCommand}"/>
            <ListView ItemsSource="{Binding Tweaks}">
              <ListView.View>
                <GridView>
                  <GridViewColumn Width="44">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Tweak" Width="220">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Group" Width="120">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Group}" Foreground="{StaticResource DimBrush}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Risk" Width="90">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Risk}" Foreground="{StaticResource WarnBrush}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Description" Width="480">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource DimBrush}" TextTrimming="CharacterEllipsis"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </Border>
      </TabItem>

      <TabItem Header="Config">
        <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="14" Margin="0,8,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <ListView ItemsSource="{Binding Fixes}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Fix" Width="230">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Description" Width="580">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Description}" Foreground="{StaticResource DimBrush}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="" Width="110">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="Run" Style="{StaticResource SmallActionButton}"
                              Tag="{Binding}" Click="Fix_Click"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </Border>
      </TabItem>

      <TabItem Header="Updates">
        <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="14" Margin="0,8,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <ListView ItemsSource="{Binding UpdatePolicies}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Policy" Width="210">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Description" Width="560">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Description}" Foreground="{StaticResource DimBrush}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="" Width="110">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="Apply" Style="{StaticResource SmallActionButton}"
                              Tag="{Binding}" Click="Policy_Click"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </Border>
      </TabItem>

      <TabItem Header="Settings">
        <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20" Margin="0,8,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                MaxWidth="520" HorizontalAlignment="Left">
          <StackPanel>
            <TextBlock Text="Git identity (optional)" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
            <TextBlock Text="Name" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding GitName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
            <TextBlock Text="Email" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding GitEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
            <TextBlock Text="Applied after Git installs via post-install scripts."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource DimBrush}" Margin="0,0,0,6"/>
      <ProgressBar Value="{Binding ProgressValue}" Maximum="100"/>
    </StackPanel>

    <DockPanel Grid.Row="3" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" Content="Install selected"
              Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}"/>
      <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}"
                 Foreground="{StaticResource DimBrush}" FontSize="13"/>
    </DockPanel>
  </Grid>
</Window>
